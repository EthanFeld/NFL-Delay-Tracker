# Optional CFBD key for authenticated college schedule/status requests.
CFBD_API_KEY=

# Optional identifying contact for api.weather.gov requests.
NWS_CONTACT_EMAIL=

# Optional GitHub Actions secret: JSON object keyed by game_id. Store no other credentials here.
GAME_OVERRIDES_JSON=

# Forecast endpoint can be changed without rebuilding frontend source.
VITE_DATA_BASE_URL=
