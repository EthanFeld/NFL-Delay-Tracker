            "type": "integer"
          },
          "minItems": 1,
          "title": "Minutes",
          "type": "array"
        },
        "weights": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Weights",
          "type": "array"
        }
      },
      "required": [
        "minutes",
        "weights"
      ],
      "title": "RestartOverhead",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "trigger_radius_miles": {
      "minimum": 0,
      "title": "Trigger Radius Miles",
      "type": "number"
    },
    "monitor_radii_miles": {
      "items": {
        "type": "number"
      },
      "title": "Monitor Radii Miles",
      "type": "array"
    },
    "quiet_period_minutes": {
      "minimum": 0,
      "title": "Quiet Period Minutes",
      "type": "integer"
    },
    "warmup_exposure_minutes": {
      "minimum": 0,
      "title": "Warmup Exposure Minutes",
      "type": "integer"
    },
    "clearance_mode": {
      "title": "Clearance Mode",
      "type": "string"
    },
